# Environment for Laravel Dusk browser tests.
# Copy to .env.dusk.local, then run: php artisan key:generate --env=dusk.local
# Dusk swaps this in for .env while `php artisan dusk` runs.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

INERTIA_SSR_ENABLED=false
